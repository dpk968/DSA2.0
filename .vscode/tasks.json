{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile & Run Java",
      "type": "shell",
      "command": "zsh",
      "args": [
        "-c",
        "javac ${file} && java ${fileBasenameNoExtension} < input.txt > output.txt"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    }
  ]
}